% ==========================================
% Часть 2: Метод парных сравнений (Саати)
% ==========================================

clc; clear; close all;

% Элементы универсального множества (вес, кг)
U2 = [55, 60, 65, 70, 75, 80];
n2 = length(U2);

% Матрица парных сравнений (обратно симметричная)
A = [1   2   3   4   5   6;
     1/2 1   2   3   4   5;
     1/3 1/2 1   2   3   4;
     1/4 1/3 1/2 1   2   3;
     1/5 1/4 1/3 1/2 1   2;
     1/6 1/5 1/4 1/3 1/2 1];

% Собственные значения и собственные векторы
[V, D] = eig(A);

% Находим максимальное собственное значение
lambda_max = max(real(diag(D)));

% Соответствующий собственный вектор
[~, idx] = max(real(diag(D)));
w = real(V(:, idx));

% Нормализация собственного вектора (сумма = 1)
w = w / sum(w);

% Степени принадлежности (координаты собственного вектора)
fprintf('============================================\n');
fprintf('Метод парных сравнений\n');
fprintf('============================================\n');
fprintf('Максимальное собственное значение: %.4f\n', lambda_max);
fprintf('\nСобственный вектор (степени принадлежности):\n');
for i = 1:n2
    fprintf('  U = %d кг:  w = %.4f\n', U2(i), w(i));
end

% Нормализация (приведение к максимуму = 1)
w_norm = w / max(w);

fprintf('\nНормализованные степени принадлежности:\n');
for i = 1:n2
    fprintf('  U = %d кг:  w_norm = %.4f\n', U2(i), w_norm(i));
end

% Мера несогласованности
IS = (lambda_max - n2) / (n2 - 1);
fprintf('\nИндекс согласованности (IS): %.4f\n', IS);

% Построение графика
figure('Name', 'Функции принадлежности (парные сравнения)', ...
       'Color', 'w');
plot(U2, w_norm, '-o', 'LineWidth', 2, 'MarkerSize', 10, ...
     'MarkerFaceColor', 'm', 'Color', 'm');
grid on; box on;
xlabel('Вес, кг', 'FontSize', 12);
ylabel('Нормализованная степень принадлежности', 'FontSize', 12);
title('Функция принадлежности (метод парных сравнений)', ...
      'FontSize', 13);
ylim([0 1.1]);
xlim([53 82]);
set(gca, 'FontSize', 11);
