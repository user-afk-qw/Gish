## ЧАСТЬ 3. Полный код MATLAB (с расчётами)

Этот код **считает всё сам** — λ_max, собственные векторы, IS, строит графики. Идеально для защиты: преподаватель видит, что ты не вписал числа, а получил их.

```matlab
% ==========================================================
% Задача 1_2. Метод парных сравнений (шкала Саати)
% Три терма: низкий, средний, высокий
% ==========================================================

clc; clear; close all;

% Элементы универсального множества (вес, кг)
U2 = [55, 60, 65, 70, 75, 80];
n2 = length(U2);

% --- Матрица для терма "НИЗКИЙ" ---
A_low = [1    2    3    4    5    6;
         1/2  1    2    3    4    5;
         1/3  1/2  1    2    3    4;
         1/4  1/3  1/2  1    2    3;
         1/5  1/4  1/3  1/2  1    2;
         1/6  1/5  1/4  1/3  1/2  1];

% --- Матрица для терма "СРЕДНИЙ" ---
A_mid = [1    1/2  1/4  1/4  1/2  1;
         2    1    1/2  1/2  1    2;
         4    2    1    1    2    4;
         4    2    1    1    2    4;
         2    1    1/2  1/2  1    2;
         1    1/2  1/4  1/4  1/2  1];

% --- Матрица для терма "ВЫСОКИЙ" ---
A_high = [1    1/2  1/3  1/4  1/5  1/6;
          2    1    1/2  1/3  1/4  1/5;
          3    2    1    1/2  1/3  1/4;
          4    3    2    1    1/2  1/3;
          5    4    3    2    1    1/2;
          6    5    4    3    2    1];

% --- Обработка трёх матриц ---
[w_low,  w_low_norm,  IS_low,  lam_low]  = process_matrix(A_low,  U2, n2, 'НИЗКИЙ');
[w_mid,  w_mid_norm,  IS_mid,  lam_mid]  = process_matrix(A_mid,  U2, n2, 'СРЕДНИЙ');
[w_high, w_high_norm, IS_high, lam_high] = process_matrix(A_high, U2, n2, 'ВЫСОКИЙ');

% --- Сводная таблица ---
fprintf('\n============================================\n');
fprintf('СВОДНАЯ ТАБЛИЦА (нормированные степени принадлежности)\n');
fprintf('============================================\n');
fprintf('%-8s %-12s %-12s %-12s\n', 'Вес', 'Низкий', 'Средний', 'Высокий');
for i = 1:n2
    fprintf('%-8d %-12.4f %-12.4f %-12.4f\n', ...
        U2(i), w_low_norm(i), w_mid_norm(i), w_high_norm(i));
end

% --- График 1: ломаные ---
figure('Name', 'Задача 1_2: Три терма (ломаные)', 'Color', 'w');
hold on; grid on; box on;
plot(U2, w_low_norm,  '-o', 'LineWidth', 2, 'MarkerSize', 8, ...
     'MarkerFaceColor', 'b', 'Color', 'b');
plot(U2, w_mid_norm,  '-s', 'LineWidth', 2, 'MarkerSize', 8, ...
     'MarkerFaceColor', 'g', 'Color', 'g');
plot(U2, w_high_norm, '-^', 'LineWidth', 2, 'MarkerSize', 8, ...
     'MarkerFaceColor', 'r', 'Color', 'r');
xlabel('Вес, кг', 'FontSize', 12);
ylabel('Нормализованная степень принадлежности', 'FontSize', 12);
title('Функции принадлежности (метод парных сравнений)', ...
      'FontSize', 13);
legend({'Низкий', 'Средний', 'Высокий'}, 'Location', 'north', ...
       'FontSize', 11);
ylim([-0.05 1.1]); xlim([53 82]);
set(gca, 'FontSize', 11);

% --- График 2: гладкие кривые ---
U_fine = linspace(55, 80, 200);
mu_low_fine  = interp1(U2, w_low_norm,  U_fine, 'pchip');
mu_mid_fine  = interp1(U2, w_mid_norm,  U_fine, 'pchip');
mu_high_fine = interp1(U2, w_high_norm, U_fine, 'pchip');

figure('Name', 'Задача 1_2: Три терма (гладкие)', 'Color', 'w');
hold on; grid on; box on;
plot(U_fine, mu_low_fine,  'b-', 'LineWidth', 2.5);
plot(U_fine, mu_mid_fine,  'g-', 'LineWidth', 2.5);
plot(U_fine, mu_high_fine, 'r-', 'LineWidth', 2.5);
xlabel('Вес, кг', 'FontSize', 12);
ylabel('Степень принадлежности \mu', 'FontSize', 12);
title('Гладкие функции принадлежности', 'FontSize', 13);
legend({'Низкий', 'Средний', 'Высокий'}, 'Location', 'north', ...
       'FontSize', 11);
ylim([-0.05 1.1]); xlim([53 82]);
set(gca, 'FontSize', 11);

% ==========================================================
%  Вспомогательная функция
% ==========================================================
function [w, w_norm, IS, lambda_max] = process_matrix(A, U2, n2, name)
    fprintf('\n============================================\n');
    fprintf('Терм: %s\n', name);
    fprintf('============================================\n');
    fprintf('Матрица парных сравнений:\n');
    disp(A);

    % Собственные значения и векторы
    [V, D] = eig(A);
    lambda_max = max(real(diag(D)));

    % Собственный вектор
    [~, idx] = max(real(diag(D)));
    w = real(V(:, idx));
    w = w / sum(w);

    % Нормировка на максимум
    w_norm = w / max(w);

    % Мера несогласованности
    IS = (lambda_max - n2) / (n2 - 1);

    % Вывод
    fprintf('lambda_max = %.4f\n', lambda_max);
    fprintf('n = %d\n', n2);
    fprintf('Мера несогласованности IS = (λmax - n)/(n-1) = %.4f\n', IS);
    fprintf('\nСобственный вектор (ненормированный):\n');
    for i = 1:n2
        fprintf('  U = %d кг:  w = %.4f\n', U2(i), w(i));
    end
    fprintf('\nСобственный вектор (нормированный, max = 1):\n');
    for i = 1:n2
        fprintf('  U = %d кг:  w_norm = %.4f\n', U2(i), w_norm(i));
    end
end
```

